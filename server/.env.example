# Copy to .env and fill in. All server settings live here.

# development | production | test
NODE_ENV=development

# Port the API listens on. If you change it, also change API_PROXY_TARGET in client/.env.
PORT=4000

# Real MongoDB connection string. Examples:
#   Local:  mongodb://127.0.0.1:27017/appointments
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/appointments?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/appointments

# Database name inside that cluster. Overrides any name in the URI path.
MONGODB_DB_NAME=appointments

# true = ignore MONGODB_URI and start a throwaway in-memory MongoDB (seeded with demo data).
# `npm run dev:memory` forces this on regardless of the value here.
USE_MEMORY_DB=false

# true = insert the 3 demo appointments on start-up when the collection is empty (real DB only).
SEED_ON_START=false

# Comma-separated browser origins allowed by CORS. The Vite dev proxy doesn't need this,
# but a client served from another origin does.
CORS_ORIGIN=http://localhost:5173
